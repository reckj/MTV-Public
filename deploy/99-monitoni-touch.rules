# Two things for libinput inside cage. Put in place by deploy/install.sh as
# /etc/udev/rules.d/99-monitoni-touch.rules (docs/SETUP.md §5).
#
# 1. The touch panel (Waveshare 7.9", USB 0712:000a) is mounted upside down in the machine, like
#    the picture (kiosk.sh turns the output by 180°). This matrix turns the touch coordinates the
#    same way, so a tap lands under the finger.
ACTION=="add|change", SUBSYSTEM=="input", KERNEL=="event*", ENV{ID_VENDOR_ID}=="0712", ENV{ID_MODEL_ID}=="000a", ENV{LIBINPUT_CALIBRATION_MATRIX}="-1 0 1 0 -1 1"
#
# 2. No mouse arrow. A vending machine has no mouse: cage draws an arrow on the display as soon
#    as its seat has any pointer device, and the touch panel never moves it. Every input node
#    that is a mouse, a touchpad or a pointing stick, whatever its vendor, is hidden from
#    libinput, so the seat has no pointer and cage draws nothing. A touchscreen is never
#    hidden, so a panel that also reports a pointer class keeps working. Found on vm001
#    2026-11-10: the Pi's own HDMI CEC inputs (vc4-hdmi-0/1) count as pointing sticks; a
#    keyboard with a touchpad (the K400) is the other case.
ACTION=="add|change", SUBSYSTEM=="input", KERNEL=="event*", ENV{ID_INPUT_TOUCHSCREEN}!="1", ENV{ID_INPUT_MOUSE}=="1", ENV{LIBINPUT_IGNORE_DEVICE}="1"
ACTION=="add|change", SUBSYSTEM=="input", KERNEL=="event*", ENV{ID_INPUT_TOUCHSCREEN}!="1", ENV{ID_INPUT_TOUCHPAD}=="1", ENV{LIBINPUT_IGNORE_DEVICE}="1"
ACTION=="add|change", SUBSYSTEM=="input", KERNEL=="event*", ENV{ID_INPUT_TOUCHSCREEN}!="1", ENV{ID_INPUT_POINTINGSTICK}=="1", ENV{LIBINPUT_IGNORE_DEVICE}="1"
